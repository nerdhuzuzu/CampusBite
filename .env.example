# =============================================================================
# Campus Canteen Management System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values. NEVER commit .env to git.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://root:yourpassword@localhost:3306/campus_canteen"

# ── Backend ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-to-a-random-64-char-secret
SESSION_SECRET=change-me-to-another-random-64-char-secret
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ── AI Service ────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_SECRET=change-me-shared-secret-between-backend-and-ai

# ── LLM (optional — rule-based fallback used when not configured) ─────────
# LLM_API_KEY=your-gemini-or-openai-api-key
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.0-flash

# ── Redis (optional — graceful fallback when unavailable) ─────────────────
# REDIS_URL=redis://localhost:6379

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── Crowd Detection ──────────────────────────────────────────────────────────
CROWD_LOW_THRESHOLD=5
CROWD_HIGH_THRESHOLD=15

# ── Cookie ────────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
