# =============================================================================
# CampusBite Backend Environment Configuration (campusbite_v2)
# Completely isolated from CampusBite V1. NEVER commit real credentials.
# =============================================================================

PORT=5002
NODE_ENV=production

# Option 1: Full MySQL / TiDB Cloud Connection URI (Recommended for Cloud Production)
# Must point to database 'campusbite_v2' (never V1's 'campus_canteen')
V2_DATABASE_URL=

# Option 2: Individual MySQL Connection Parameters
V2_DB_HOST=localhost
V2_DB_PORT=3306
V2_DB_USER=root
V2_DB_PASSWORD=your_mysql_password
V2_DB_NAME=campusbite_v2
V2_DB_SSL=false
V2_DB_POOL_LIMIT=12

# JWT & Session Secrets (Generate 64-character random hex strings in production)
V2_JWT_SECRET=replace_with_64_char_random_jwt_secret
V2_REFRESH_SECRET=replace_with_64_char_random_refresh_secret

# CORS & Frontend URL (Set to your deployed Vercel domain, e.g. https://campusbite-v2.vercel.app)
V2_FRONTEND_URL=https://campusbite-v2.vercel.app
V2_CORS_ORIGINS=https://campusbite-v2.vercel.app,http://localhost:5174

# One-Time Administrator Bootstrap (used by: npm run bootstrap:admin)
ADMIN_BOOTSTRAP_NAME=Platform Administrator
ADMIN_BOOTSTRAP_EMAIL=admin@campusbite-v2.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMeAdmin@2026!

# -----------------------------------------------------------------------------
# Gmail SMTP Email-Only OTP Configuration (STARTTLS Port 587)
# Note: Enable 2-Step Verification on your Google account and generate a 16-char App Password.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM="CampusBite <your-email@gmail.com>"

# -----------------------------------------------------------------------------
# Optional Cloud Object Storage (Cloudinary)
# Note: By default, food images are stored persistently in MySQL LONGBLOB (/api/v2/public/media/:id).
# If Cloudinary is configured below, uploads will also be mirrored to Cloudinary CDN.
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Razorpay Payment Gateway (Use rzp_test_* keys for Test Mode verification first)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Optional Gemini AI Assistant
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
LLM_MODEL=gemini-2.0-flash
