# =============================================================================
# CampusBite Frontend Production & Development Environment Variables
# Copy to .env.local or configure in Vercel Project Settings -> Environment Variables
# =============================================================================

# Backend REST API Base URL (e.g. https://campusbite-v2-api.onrender.com/api/v2)
VITE_V2_API_URL=https://campusbite-v2-api.onrender.com/api/v2

# Backend WebSocket / Socket.IO Origin (e.g. https://campusbite-v2-api.onrender.com)
VITE_V2_WS_URL=https://campusbite-v2-api.onrender.com

# Official Public Website URL used by the Login Page Share QR Code
VITE_PUBLIC_APP_URL=https://campusbite-v2.vercel.app
